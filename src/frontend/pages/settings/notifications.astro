---
/**
 * RESPONSIVE STRATEGY
 * desktop: one Frame holding the category × channel checkbox matrix (settings-11) with column and row toggles, footer save bar.
 * mobile (390px): category descriptions hide; five compact checkbox columns fit 390px without horizontal scroll.
 * vehicle: same as mobile; checkbox hit areas extend beyond the 16px box.
 *
 * @fileoverview /settings/notifications — channel × category delivery matrix,
 * backed by /api/settings/notification-prefs.
 */

import SettingsLayout from "@/layouts/SettingsLayout.astro";
import { NotificationPrefsMatrix } from "@/components/settings";
---

<SettingsLayout
  title="Notifications"
  description="Choose which notification categories reach you on each channel."
>
  <NotificationPrefsMatrix client:load />
</SettingsLayout>
