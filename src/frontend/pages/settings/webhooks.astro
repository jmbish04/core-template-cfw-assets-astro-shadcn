---
/**
 * RESPONSIVE STRATEGY
 * desktop: one Frame of endpoint rows (settings-8): health alerts, status badge, copyable URL, enable switch, actions menu.
 * mobile (390px): the endpoint icon hides and rows stack name / URL / meta; add + edit opens as a bottom Sheet instead of a dialog.
 * vehicle: same as mobile; destructive actions stay behind the menu and a confirm dialog.
 *
 * @fileoverview /settings/webhooks — CRUD + test surface for outbound webhooks,
 * backed by /api/webhooks.
 */

import SettingsLayout from "@/layouts/SettingsLayout.astro";
import { WebhooksTable } from "@/components/settings";
---

<SettingsLayout
  title="Webhooks"
  description="Register, edit, test, and remove outbound webhook deliveries."
>
  <WebhooksTable client:load />
</SettingsLayout>
