---
/**
 * RESPONSIVE STRATEGY
 * desktop: search + two filter selects, then a day-grouped timeline (solution-users-6) whose events expand into detail Frames.
 * mobile (390px): filters stack (search full width, selects 2-up); timeline stays single column, detail grid goes 1-up.
 * vehicle: same as mobile; reading-only, expand taps are full-width rows.
 *
 * @fileoverview /settings/activity — filterable audit trail, backed by
 * /api/activity.
 */

import SettingsLayout from "@/layouts/SettingsLayout.astro";
import { ActivityTimeline } from "@/components/settings";
---

<SettingsLayout
  title="Activity"
  description="Search and filter the append-only audit trail of recent actions."
>
  <ActivityTimeline client:load />
</SettingsLayout>
