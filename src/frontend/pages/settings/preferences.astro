---
/**
 * RESPONSIVE STRATEGY
 * desktop: three collapsible Frame sections (settings-9) of label | control rows, footer save + discard bar.
 * mobile (390px): rows wrap so the control drops under its label; the save bar sticks to the bottom while dirty.
 * vehicle: same as mobile; switches and selects are 36px targets.
 *
 * @fileoverview /settings/preferences — Appearance, Language & Region, and
 * Accessibility preferences, backed by /api/settings/preferences.
 */

import SettingsLayout from "@/layouts/SettingsLayout.astro";
import { PreferencesForm } from "@/components/settings";
---

<SettingsLayout
  title="Preferences"
  description="Tune appearance, locale, and accessibility for your workspace."
>
  <PreferencesForm client:load />
</SettingsLayout>
