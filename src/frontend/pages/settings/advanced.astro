---
/**
 * RESPONSIVE STRATEGY
 * desktop: stacked Frame cards (settings-10): system status, maintenance, and a danger zone with a confirm dialog.
 * mobile (390px): rows wrap so buttons drop under their descriptions; cards stay full width.
 * vehicle: same as mobile; the destructive action always needs a second confirm tap.
 *
 * @fileoverview /settings/advanced — system info + danger zone, backed by
 * /api/ping and /api/notifications.
 */

import SettingsLayout from "@/layouts/SettingsLayout.astro";
import { AdvancedPanel } from "@/components/settings";
---

<SettingsLayout
  title="Advanced"
  description="Read-only system status plus soft resets and destructive actions."
>
  <AdvancedPanel client:load />
</SettingsLayout>
