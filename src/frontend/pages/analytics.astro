---
/**
 * RESPONSIVE STRATEGY
 * desktop: 3-cell metric row → status distribution | priority ranking → per-project progress Data Grid.
 * mobile (390px): metric cells collapse to dense label | value rows; panels stack; the grid becomes a 2-column summary list linking to /tasks?projectId=.
 * vehicle: not a target surface — the mobile layout applies.
 *
 * Team analytics — all-time aggregates from `GET /api/tasks` + `GET /api/projects`.
 * Mounts the TeamAnalyticsView island (client:load, fetch-based).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageBody, PageToolbar } from "@/components/blocks/app-shell-12/components/page-toolbar";
import { TeamAnalyticsView } from "@/components/dashboard";
---

<BaseLayout
  title="Team Analytics"
  description="Completion rate, status and priority breakdowns, overdue counts and per-project progress."
>
  <PageBody>
    <PageToolbar
      title="Team analytics"
      description="How work splits across status and priority, what's overdue, and how each project is progressing."
    />
    <TeamAnalyticsView client:load />
  </PageBody>
</BaseLayout>
