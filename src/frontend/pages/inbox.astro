---
/**
 * RESPONSIVE STRATEGY
 * desktop: one Frame, 440px message list beside the reading pane (ReUI app-shell-4 content area).
 * mobile (390px): list fills the frame; tapping a row opens the reader as a full-width Sheet.
 * vehicle: not targeted — large-tap list rows stay usable, no hover-only actions.
 *
 * Inbox — Cloudflare Email Routing showcase. Mail sent to a routed address hits
 * the Worker's `email()` handler, is stored in D1 (`email_messages`), and is
 * read here from `GET /api/inbox`. Plain-fetch island, so `client:load`.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageBody, PageToolbar } from "@/components/blocks/app-shell-12/components/page-toolbar";
import { Inbox } from "@/components/inbox";
---

<BaseLayout
  title="Inbox"
  description="A two-pane email inbox powered end-to-end by Cloudflare Email Routing: inbound mail is parsed by the Worker's email() handler, stored in D1, and read here."
>
  <PageBody>
    <PageToolbar
      title="Inbox"
      description="Mail sent to a routed address is parsed by the Worker's email() handler, stored in D1, and shown here."
    />
    <Inbox client:load />
  </PageBody>
</BaseLayout>
