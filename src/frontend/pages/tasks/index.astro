---
/**
 * RESPONSIVE STRATEGY
 * desktop: toolbar, then one Frame — status tabs, search + ReUI Filters builder + View popover, the Data Grid (sort, group, paginate).
 * mobile (390px): the grid is swapped for a dense title|status list that opens the preview (a bottom sheet); no horizontal scroll.
 * vehicle: same as mobile; each row is a full-width tap target.
 *
 * Tasks list — ReUI Data Grid over `GET /api/tasks`. `?projectId=` seeds a
 * Project filter rule (project deep-links) and `?q=` seeds the search box.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageBody, PageToolbar } from "@/components/blocks/app-shell-12/components/page-toolbar";
import { TaskList } from "@/components/tasks/TaskList";

const initialProjectId = Astro.url.searchParams.get("projectId") ?? undefined;
const initialQ = Astro.url.searchParams.get("q") ?? undefined;
---

<BaseLayout
  title="Tasks"
  description="Every task in one grid. Search, build filters by field, group by status, priority or project, and open any task."
>
  <PageBody>
    <PageToolbar
      title="Tasks"
      description="Search, filter by any field, group, and sort. Click a row to preview it."
    />
    <TaskList client:load initialProjectId={initialProjectId} initialQ={initialQ} />
  </PageBody>
</BaseLayout>
