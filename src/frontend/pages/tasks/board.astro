---
/**
 * RESPONSIVE STRATEGY
 * desktop: toolbar, then the ReUI Kanban — four Frame columns side by side; drag cards between them (status persists).
 * mobile (390px): columns become a snap-scrolling carousel, one near-full-width column at a time; card tap opens the preview sheet.
 * vehicle: same as mobile; cards are large tap targets, drag is optional (edit status in the preview).
 *
 * Task board — kanban over `GET /api/tasks/board`; moves PATCH `/api/tasks/{id}`.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageBody, PageToolbar } from "@/components/blocks/app-shell-12/components/page-toolbar";
import { TaskBoard } from "@/components/tasks/TaskBoard";
---

<BaseLayout
  title="Task board"
  description="Kanban across Not Started, In Progress, In Review and Done. Drag a card to another column and the status is saved."
>
  <PageBody>
    <PageToolbar
      title="Task board"
      description="Drag a card to another column to change its status. It saves straight away."
    />
    <TaskBoard client:load />
  </PageBody>
</BaseLayout>
