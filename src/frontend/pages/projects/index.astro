---
/**
 * RESPONSIVE STRATEGY
 * desktop: toolbar, then one Frame — search, status/starred/sort selects, and a 3-up grid of project Frames (or a list view).
 * mobile (390px): filters wrap; project tiles go 1-up as compact rows; the preview and create dialogs open as bottom sheets.
 * vehicle: same as mobile; each project row is a full-width tap target.
 *
 * Projects index — `GET /api/projects` with search, filters, stars and create.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageBody, PageToolbar } from "@/components/blocks/app-shell-12/components/page-toolbar";
import { ProjectList } from "@/components/tasks/ProjectList";
---

<BaseLayout
  title="Projects"
  description="Browse, search, star, and create projects. Each project groups tasks and notes under a named, colour-coded entity."
>
  <PageBody>
    <PageToolbar
      title="Projects"
      description="Search, filter by status, and star the ones you care about. Click a project for its details."
    />
    <ProjectList client:load />
  </PageBody>
</BaseLayout>
