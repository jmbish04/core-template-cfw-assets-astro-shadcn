---
/**
 * RESPONSIVE STRATEGY
 * desktop: metric row (4 cells) → hero chart → 3-up distribution row → open-tasks Data Grid → insights | activity.
 * mobile (390px): metric cells collapse to dense label | value rows; panels stack; the grid becomes a 2-column summary list linking to /tasks/[id].
 * vehicle: not a target surface — the mobile layout applies (large tap targets, no hover-only affordances).
 *
 * Admin dashboard. Static PageToolbar chrome from app-shell-12, then the single
 * `<AdminDashboard>` island (`client:load`, fetch-based) which owns data
 * fetching, filters, charts, AI insights, the action grid and activity feed.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageBody, PageToolbar } from "@/components/blocks/app-shell-12/components/page-toolbar";
import { AdminDashboard } from "@/components/dashboard";
---

<BaseLayout
  title="Dashboard"
  description="Live operational overview: project and task KPIs, trends, open work, Workers AI insights and recent activity."
>
  <PageBody>
    <PageToolbar
      title="Dashboard"
      description="Project and task KPIs, trends and the open work that needs action."
    />
    <AdminDashboard client:load />
  </PageBody>
</BaseLayout>
